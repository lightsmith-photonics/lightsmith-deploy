# Copy to .env with `uv run --no-project python scripts/prepare.py`, which fills every empty secret
# below with a random value. Never commit .env.

# ---- Sources ----
# Folder holding the sibling checkouts (lightsmith-community, -studio, -cloud, -materials and the
# library). Relative paths are relative to this folder.
REPOS_DIR=..
# Library wheel under ./wheels and lightsmith-cloud/wheels; written by scripts/prepare.py.
LIBRARY_WHEEL=

# ---- Secrets (generated) ----
POSTGRES_PASSWORD=
COMMUNITY_DB_PASSWORD=
CLOUD_DB_PASSWORD=
MATERIALS_DB_PASSWORD=
# HS256 secret Community signs its 5-minute tokens for Cloud (aud compute) and Materials (aud materials-db) with.
PLATFORM_JWT_SECRET=
COMMUNITY_AUTH_SECRET=
CLOUD_API_KEY_PEPPER=
# Bearer token with the admin role on the Cloud API (usage, plans).
CLOUD_ADMIN_TOKEN=
COMMUNITY_S3_SECRET=
CLOUD_S3_SECRET=

# ---- Public URLs, as browsers see them ----
# Behind a reverse proxy with TLS, set these to the public https:// origins (and CLOUD_WS_URL to wss://).
COMMUNITY_URL=http://localhost:3000
STUDIO_URL=http://localhost:8080
CLOUD_URL=http://localhost:8200
CLOUD_WS_URL=ws://localhost:8200
MATERIALS_URL=http://localhost:8100

# ---- Host ports ----
# 0.0.0.0 publishes them beyond this machine; keep 127.0.0.1 behind a reverse proxy.
BIND_ADDRESS=127.0.0.1
COMMUNITY_PORT=3000
STUDIO_PORT=8080
CLOUD_PORT=8200
MATERIALS_PORT=8100
POSTGRES_PORT=55432
MAILPIT_UI_PORT=58025

# ---- Community sign-in ----
# Comma-separated emails that become admins on first sign-in.
ADMIN_EMAILS=
# Mailpit catches sign-in mail locally (UI on MAILPIT_UI_PORT). Production: smtp://user:pass@host:587
EMAIL_SERVER=smtp://mailpit:1025
EMAIL_FROM=Lightsmith Community <no-reply@lightsmith.test>
# GitHub OAuth, enabled when both are set. Callback: <COMMUNITY_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_REPO_URL=
PAPER_URL=

# ---- Cloud ----
# GPU tiers "queue:GiB:credit_multiplier", smallest first.
GPU_TIERS=gpu-12g:12:1.0,gpu-24g:24:1.0,gpu-80g:80:3.0
# Queues the CPU worker serves. With `--profile gpu` on a 12 GB card, use gpu-24g,gpu-80g.
CPU_WORKER_QUEUES=gpu-12g,gpu-24g,gpu-80g
# Stripe TEST mode only (sk_test_...); empty disables billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Materials ----
RII_COMMIT=c5c2f188e848453def5970e347399d653df2ffc2
CROSSREF_ENABLED=true
# A contact address puts DOI lookups in Crossref's polite pool.
CROSSREF_MAILTO=
